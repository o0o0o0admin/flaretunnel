# FlareTunnel auto-start defaults (used when container starts with --api)
# Workers to ensure on startup (created if fewer exist)
FLARETUNNEL_WORKERS=10
# Distribute workers across accounts based on quota (true/false)
FLARETUNNEL_DISTRIBUTE=true
# Rotation mode: round-robin or random
FLARETUNNEL_ROTATION=round-robin
# Verbose logging for tunnel (true/false)
FLARETUNNEL_VERBOSE=false
# Optional: host/port for tunnel (defaults used if not set)
# FLARETUNNEL_HOST=0.0.0.0
# FLARETUNNEL_PORT=8080
# FLARETUNNEL_BLACKLIST=blacklist-minimal.txt
